	<!--
		Duels - the player menu. One card for !guns, !rifles, !pistols and !rounds (the loadout page), and the admin
		arena tester, css_dtestarenas (the arenas page). Replaces the CS2MenuManager chat and WASD menus. Driven by
		CS2_Poor_Duels_src/Hud/DuelsMenu.cs.

		LOADOUT: the round types as toggles (art = the weapon the player would hold in that duel, the kit under the
		name, ON / OFF), then a rifle and a pistol column: the weapon tiles with the saved one marked, and the round
		types the choice is used in (rounds that do not force that slot). The command that opened it lights its own
		section; the same command again closes it.

		ARENAS: every custom arena on the map as a tile with two teleport buttons, 16 a page.

		CONTRACT (DuelsMenu.cs must match)
		  RootPanelId = "DuelsMenuRoot"   RevealClass = "show"   CloseButtonId = "dm_close"   RowCount = 0
		  CaptureInput = true             HideHud = None         SharedText = false

		The root is the full screen and draws nothing; the card inside has the reveal.

		POOLS
		  dm_r0..dm_r5                    round toggles, one row; the row's nN class sizes them
		  dm_w0_0..dm_w0_11 (rifle)       weapon tiles, 3 rows of 4 (dm_c0_row0..2)
		  dm_w1_0..dm_w1_11 (pistol)      weapon tiles, 3 rows of 4 (dm_c1_row0..2)
		  dm_c0_u0..5, dm_c1_u0..5        "used in" round chips
		  da_t0..da_t15                   arena tiles, 4 rows of 4 (da_row0..3)
		  dm_cmd0..3                      footer commands

		BUTTONS (PanelAction.Button, by id)
		  dm_close                        close (the library handles it)
		  dm_rN                           switch round type N on or off
		  dm_w0_N / dm_w1_N               save rifle / pistol N
		  da_tN_s1 / da_tN_s2             teleport to arena N's spawn 1 / 2
		  da_prev da_next                 arena pages

		DIALOG VARIABLES
		  dm_title dm_tag dm_intro                                  header and intro
		  dm_r_h dm_r_hint dm_on dm_off dm_rN_n dm_rN_k             rounds: head, hint, pills, name, kit
		  dm_cN_t dm_cN_v dm_saved_k dm_use_k dm_cN_uM dm_cN_none   columns: title, saved weapon, labels, chips
		  dm_wC_N                                                   weapon names
		  da_tN_n da_k da_s1 da_s2                                  arena tiles
		  dm_cmdN dm_cmd_tail dm_page                               footer

		CLASSES THE SERVER TOGGLES
		  dm          arenas (the arenas page) | f-rounds | f-rifle | f-pistol (the section asked for)
		              paged (arena pages) | noarenas
		  dm_rounds   n1 .. n6 (how many round tiles show) | big (four or fewer: bigger art)
		  dm_rN       hidden | on | w-<weapon>
		  dm_cN       unused (no round type uses it) | nosave (nothing saved yet)
		  dm_cN_uM, dm_cN_rowR, dm_wC_N, da_rowR, da_tN, dm_cmdN   hidden
		  dm_wC_N     saved | w-<weapon>
		  w-<weapon>  ak47 m4a1_silencer m4a1 galilar famas sg556 aug awp ssg08 deagle glock usp_silencer hkp2000
		              elite tec9 p250 cz75a fiveseven revolver; none of them = the crosshair
	-->
